<%- include('../partials/header') %>
<main>
    <h1>Faculty Directory</h1>
    <p>Browse our faculty members and click on any name to view their contact information and details.</p>
    
    <div class="sort-options">
        <span>Sort by: </span>
        <a href="/faculty" class="<%= sortBy === 'name' ? 'active' : '' %>">Name</a>
        <a href="/faculty?sortBy=department" class="<%= sortBy === 'department' ? 'active' : '' %>">Department</a>
        <a href="/faculty?sortBy=title" class="<%= sortBy === 'title' ? 'active' : '' %>">Title</a>
    </div>
    
    <ul class="faculty-list">
        <% facultyList.forEach(member => { %>
            <li class="faculty-card">
                <span class="faculty-avatar">
                    <%= member.name.split(' ').map(n => n[0]).join('') %>
                </span>
                <div class="faculty-info">
                    <h3><a href="/faculty/<%= member.id %>"><%= member.name %></a></h3>
                    <p class="faculty-title"><%= member.title %></p>
                    <p class="faculty-department"><%= member.department %></p>
                </div>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('../partials/footer') %>
